{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-desk",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relay-desk",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://relay-desk.REPLACE_WITH_WORKERS_SUBDOMAIN.workers.dev",
    "GITHUB_OWNER_ID": "REPLACE_WITH_GITHUB_OWNER_ID",
    "GITHUB_REPOSITORY": "REPLACE_WITH_GITHUB_USERNAME/relay-desk",
    "GITHUB_REPOSITORY_ID": "REPLACE_WITH_GITHUB_REPOSITORY_ID",
    "GITHUB_WORKFLOW": "detector.yml",
    "GITHUB_REF": "refs/heads/main"
  },
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
}
